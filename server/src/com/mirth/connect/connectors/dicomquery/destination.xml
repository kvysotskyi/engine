<connectorMetaData path="dicomquery">
	<name>DICOM C-FIND SCU</name>
	<author>NextGen Healthcare</author>
	<pluginVersion>@mirthversion</pluginVersion>
	<mirthVersion>@mirthversion</mirthVersion>
	<url>https://openintegrationengine.org</url>
	<description>Sends DICOM C-FIND requests to a remote DICOM node (SCP) and returns the matching results as XML. Supports Study Root, Patient Root, and Modality Worklist information models.</description>
	<clientClassName>com.mirth.connect.connectors.dicomquery.DICOMQuerySender</clientClassName>
	<serverClassName>com.mirth.connect.connectors.dicomquery.DICOMQueryDispatcher</serverClassName>
	<sharedClassName>com.mirth.connect.connectors.dicomquery.DICOMQueryDispatcherProperties</sharedClassName>
	<library type="CLIENT" path="dicomquery-client.jar" />
	<library type="SHARED" path="dicomquery-shared.jar" />
	<library type="SERVER" path="dicomquery-server.jar" />
	<library type="SERVER" path="lib/dcm4che-core-2.0.29.jar" />
	<library type="SERVER" path="lib/dcm4che-net-2.0.29.jar" />
	<transformers></transformers>
	<protocol>dicomquery</protocol>
	<type>DESTINATION</type>
</connectorMetaData>
