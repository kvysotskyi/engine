<connectorMetaData path="dicomweb">
	<name>DICOMweb QIDO-RS Query</name>
	<author>NextGen Healthcare</author>
	<pluginVersion>@mirthversion</pluginVersion>
	<mirthVersion>@mirthversion</mirthVersion>
	<url>https://openintegrationengine.org</url>
	<description>Queries a remote DICOMweb server using QIDO-RS (GET /studies, /series, /instances). Returns a JSON or XML array of matching DICOM objects.</description>
	<clientClassName>com.mirth.connect.connectors.dicomweb.QIDORSSender</clientClassName>
	<serverClassName>com.mirth.connect.connectors.dicomweb.QIDORSDispatcher</serverClassName>
	<sharedClassName>com.mirth.connect.connectors.dicomweb.QIDORSDispatcherProperties</sharedClassName>
	<library type="CLIENT" path="dicomweb-client.jar" />
	<library type="SHARED" path="dicomweb-shared.jar" />
	<library type="SERVER" path="dicomweb-server.jar" />
	<transformers></transformers>
	<protocol>dicomweb</protocol>
	<type>DESTINATION</type>
</connectorMetaData>
